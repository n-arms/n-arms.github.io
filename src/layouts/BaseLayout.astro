---
interface Props {
  title: string;
  ogTitle?: string;
  description?: string;
}

import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-600.css';
import PersonJsonLd from '../components/PersonJsonLd.astro';

const {
  title,
  ogTitle = title,
  description = 'Nick Armstrong — computer engineering student at Waterloo.',
} = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://n-arms.github.io');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL.href} />
    <link rel="canonical" href={canonicalURL.href} />
    <PersonJsonLd />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <main>
      <nav class="topnav" aria-label="Site navigation">
        <a href="/">Nick Armstrong</a>
        <span aria-hidden="true">·</span>
        <a href="/blog">Blog</a>
      </nav>
      <slot />
    </main>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    min-height: 100%;
    background: #fff;
    color: #000;
    font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif;
  }

  body {
    display: block;
    text-align: left;
    padding: 2rem 1rem;
    box-sizing: border-box;
  }

  main {
    max-width: 54rem;
    width: 100%;
    margin: 0 auto;
    box-sizing: border-box;
  }

  .topnav {
    display: flex;
    gap: 0.5rem;
    align-items: baseline;
    font-size: 0.95rem;
    margin-bottom: 2rem;
  }

  .topnav a:first-child {
    font-weight: 600;
  }

  :global(a) {
    color: inherit;
  }

  :global(.prose) {
    line-height: 1.7;
    font-size: 1rem;
  }

  :global(.prose h1) {
    font-size: 2rem;
    font-weight: 600;
    margin: 0 0 0.5rem;
    line-height: 1.2;
  }

  :global(.prose h2) {
    font-size: 1.4rem;
    margin: 2rem 0 0.5rem;
  }

  :global(.prose p),
  :global(.prose ul),
  :global(.prose ol) {
    margin: 0.75rem 0;
  }

  :global(.prose pre) {
    overflow-x: auto;
    border: 1px solid #000;
    padding: 0.75rem;
    font-size: 0.85rem;
  }

  :global(.prose code) {
    font-size: 0.9em;
  }
</style>
