---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
// Newest first — the archive is ordered by time.
const posts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const formatDate = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });
---

<BaseLayout title="Blog — Nick Armstrong" description="Writing on embedded systems, robotics, tinyML, and building things.">
  <div class="prose">
    <h1>Blog</h1>
  </div>

  <ul class="archive-list">
    {posts.map((post) => (
      <li>
        <a href={`/blog/${post.id.replace(/\.mdx?$/, '')}/`}>{post.data.title}</a>
        <span class="meta">
          <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
          {post.data.tags?.length ? ` · ${post.data.tags.join(', ')}` : ''}
        </span>
        {post.data.description ? <p class="desc">{post.data.description}</p> : null}
      </li>
    ))}
  </ul>

  {posts.length === 0 && <p>No posts yet. Check back soon.</p>}

  <p class="back"><a href="/">← Back home</a></p>
</BaseLayout>

<style>
  .lede {
    opacity: 0.7;
    margin-top: 0;
  }

  .archive-list {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .archive-list li a {
    font-weight: 600;
    font-size: 1.1rem;
  }

  .archive-list .meta {
    display: block;
    font-size: 0.875rem;
    opacity: 0.6;
    margin-top: 0.15rem;
  }

  .archive-list .desc {
    margin: 0.35rem 0 0;
    line-height: 1.6;
  }

  .back {
    margin-top: 2.5rem;
  }
</style>
